{
  "$schema": "../gen/schemas/capabilities.json",
  "identifier": "default",
  "description": "Default permissions for the RPEngine Manager window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "dialog:allow-open"
  ]
}
