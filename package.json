{
  "name": "rpengine-manager",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "version:check": "node scripts/verify-version.mjs",
    "version:test": "node --test scripts/verify-version.node-test.mjs",
    "test": "vitest run",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked --all-targets",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build -- --locked",
    "tauri:build:ci": "tauri build --config src-tauri/tauri.ci.conf.json -- --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.11.0",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
